#!/usr/bin/env python3
"""Reorder herdr workspaces.

Usage:
  herdr-ws-move up|down          move the active workspace one slot
  herdr-ws-move <N>              move the active workspace to position N (1-based)
  herdr-ws-move <id> <up|down|N> move a specific workspace (e.g. w7 2)
"""
import json
import os
import socket
import sys

SOCK = os.environ.get("HERDR_SOCKET_PATH", os.path.expanduser("~/.config/herdr/herdr.sock"))


def call(method, params):
    s = socket.socket(socket.AF_UNIX)
    s.connect(SOCK)
    s.sendall((json.dumps({"id": "ws-move", "method": method, "params": params}) + "\n").encode())
    buf = b""
    while not buf.endswith(b"\n"):
        chunk = s.recv(65536)
        if not chunk:
            break
        buf += chunk
    s.close()
    resp = json.loads(buf)
    if "error" in resp:
        sys.exit(f"herdr-ws-move: {resp['error']}")
    return resp["result"]


def main(argv):
    if len(argv) == 1:
        ws_id = os.environ.get("HERDR_ACTIVE_WORKSPACE_ID") or os.environ.get("HERDR_WORKSPACE_ID")
        target = argv[0]
    elif len(argv) == 2:
        ws_id, target = argv
    else:
        sys.exit(__doc__)
    if not ws_id:
        sys.exit("herdr-ws-move: no workspace id (not inside herdr?)")

    ids = [w["workspace_id"] for w in call("workspace.list", {})["workspaces"]]
    if ws_id not in ids:
        sys.exit(f"herdr-ws-move: unknown workspace {ws_id}")
    current = ids.index(ws_id)

    if target == "up":
        index = current - 1
    elif target == "down":
        index = current + 1
    elif target.isdigit():
        index = int(target) - 1
    else:
        sys.exit(__doc__)
    index = max(0, min(index, len(ids) - 1))
    if index != current:
        call("workspace.move", {"workspace_id": ws_id, "insert_index": index})


if __name__ == "__main__":
    main(sys.argv[1:])

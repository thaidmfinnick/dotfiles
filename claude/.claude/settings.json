{
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "300000"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/context-bar.sh"
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true,
    "pw@pancake-work": true,
    "tn@talent-netzwerk-kit": true
  },
  "extraKnownMarketplaces": {
    "humanizer": {
      "source": {
        "source": "github",
        "repo": "blader/humanizer"
      }
    },
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    },
    "pancake-work": {
      "source": {
        "source": "directory",
        "path": "/Users/admin/Data/projects/pancake-work/pancake-work-claude-plugins"
      }
    },
    "talent-netzwerk-kit": {
      "source": {
        "source": "directory",
        "path": "/Users/admin/Data/projects/talent/talent-netzwerk-kit"
      }
    }
  },
  "effortLevel": "medium",
